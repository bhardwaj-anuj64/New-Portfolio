JWT_KEY=replace-with-a-long-random-secret

# Comma-separated origins allowed to call the Gateway's API. Leave unset for local dev (falls
# back to appsettings.json's Cors:AllowedOrigins); required in docker-compose.prod.yml.
ALLOWED_ORIGINS=https://anujb.dev,https://www.anujb.dev

# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > install a connector > copy the
# token out of the generated `cloudflared tunnel run --token <...>` command.
CLOUDFLARE_TUNNEL_TOKEN=

# owner/repo of this GitHub repository, lowercase (ghcr.io requires lowercase image paths) — used
# by docker-compose.prod.yml to pull images the GitHub Actions workflow publishes.
GHCR_NAMESPACE=your-github-username/your-repo-name

# Private ntfy.sh topic name (unguessable — anyone who knows it can read or post to it, so treat
# it like a secret). Used for both admin OTP delivery and deploy-failure alerts. Subscribe to it
# in the ntfy app to receive both. Generate with e.g.
# `python -c "import secrets; print('anujb-dev-' + secrets.token_hex(16))"`.
NTFY_TOPIC=

# Shared secret the deploy workflow presents to POST /api/notify/deploy-failure to push a failure
# alert via the ntfy topic above (same channel as admin OTP delivery). Must match the
# DEPLOY_NOTIFY_SECRET repo secret in GitHub Actions exactly. Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
DEPLOY_NOTIFY_SECRET=
